   "source": [
    "# broadcast --> This cell is for understanding and applying broadcast variable. \n"
    "'''\n",
    "from pyspark.sql.functions import broadcast\n",
    "customers_broadcast=broadcast(df_customers_dataset)\n",
    "optimized_customer_broadcast=full_orders_df.join(customers_broadcast, \"customer_id\")\n",
    "display(optimized_customer_broadcast)\n",
    "\n",
    "'''"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
