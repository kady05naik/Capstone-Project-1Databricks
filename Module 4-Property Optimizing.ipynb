    }
   },
   "outputs": [],
   "source": [
    "# sort & merge join\n",
    "'''\n",
    "sorted_customers_df=df_customers_dataset.sortWithinPartitions('customer_id')\n",
    "sorted_orders_df=full_orders_df.sortWithinPartitions('customer_id')\n",
    "\n",
    "optimized_merge_full_orders_df=sorted_orders_df.join(sorted_customers_df,'customer_id')\n",
    "\n",
    "'''"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 0,
   "metadata": {
    "application/vnd.databricks.v1+cell": {
